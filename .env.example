# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Use 127.0.0.1 rather than localhost: on Windows, localhost can resolve to the
# IPv6 ::1 first and stall the driver before it falls back to IPv4.
MONGODB_URI=mongodb://127.0.0.1:27017/consultency

# --- Auth (NextAuth v5 / Auth.js) -------------------------------------------
# v5 reads AUTH_SECRET (not NEXTAUTH_SECRET). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me
# Only needed if the app is not served from the URL NextAuth infers.
AUTH_URL=http://localhost:3000

# --- Site -------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for metadataBase, so relative OG
# image paths resolve for social scrapers. Without it, share cards come out blank.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Image uploads (Cloudinary) ---------------------------------------------
# Free tier, no card required. Grab all three from the Cloudinary dashboard
# under Settings -> API Keys.
#
# CLOUDINARY_API_SECRET signs upload requests and must never reach the browser.
# That is why none of these are NEXT_PUBLIC_: the cloud name and API key are
# handed to the client by POST /api/upload/signature instead.
CLOUDINARY_CLOUD_NAME=h3lzpfdh
CLOUDINARY_API_KEY=171817218114734
CLOUDINARY_API_SECRET=bqP3S01LGnt3A7_D-QuMmz50w1U

# --- Seed -------------------------------------------------------------------
# Consumed by `npm run seed` only.
SEED_ADMIN_EMAIL=admin@consultency.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Admin

